.check-field strong { color: #4e4c45; font-size: 9px; }
.check-field small { color: #8d897f; font-size: 8px; font-weight: 400; line-height: 1.4; }
.modal-footer { display: grid; grid-template-columns: 1fr; gap: 8px; margin-top: 15px; }
.modal-footer.with-delete { grid-template-columns: auto 1fr; }
.modal-submit { width: 100%; }
.button.delete-asset { color: #a44a38; background: #f4e8e3; border-color: #e2c5ba; }
.button.delete-asset:hover { background: #eed8cf; }
.template-save-modal { width: 430px; max-width: calc(100vw - 36px); position: relative; padding: 25px; border: 1px solid #d7d1c5; border-radius: 16px; background: #f9f7f1; box-shadow: 0 30px 80px rgba(25,24,21,.25); }
.template-save-modal h2 { margin: 6px 0 7px; font-size: 20px; }
.template-save-modal > p { margin: 0 34px 16px 0; color: #7b776e; font-size: 10px; line-height: 1.65; }
.template-save-summary { display: flex; align-items: center; gap: 10px; padding: 12px; border: 1px solid #cbd8d0; border-radius: 10px; color: var(--green); background: #edf3ef; }
.template-save-summary > svg { flex: 0 0 auto; }
.template-save-summary > span { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.template-save-summary strong { color: #3c4d44; font-size: 11px; }
.template-save-summary small { color: #7e8c84; font-size: 8px; }
.template-name-field { display: block; margin-top: 15px; }
.template-name-field > span { display: block; margin-bottom: 6px; color: #646159; font-size: 9px; font-weight: 700; }
.template-name-field input { width: 100%; height: 40px; padding: 0 10px; border: 1px solid var(--line); border-radius: 8px; background: #fffefa; color: #373631; font-size: 11px; }
.template-name-field > small { display: block; margin-top: 5px; color: #99958b; font-size: 8px; }
.template-modal-actions { display: grid; grid-template-columns: 92px 1fr; gap: 8px; margin-top: 17px; }

.reference-modal-backdrop { padding: 18px; }
.reference-modal {
  width: min(1060px, calc(100vw - 36px)); height: min(820px, calc(100vh - 36px)); min-height: 580px;
  position: relative; display: flex; flex-direction: column; overflow: hidden;
  background: #f7f4ed; border: 1px solid #d5d0c4; border-radius: 16px;
  box-shadow: 0 30px 90px rgba(25,24,21,.28);
}
.reference-modal-heading { min-height: 92px; flex: 0 0 auto; padding: 20px 60px 16px 22px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--line); }
.reference-modal-heading h2 { margin: 4px 0 4px; font-size: 19px; }
.reference-modal-heading p { margin: 0; color: #7c786f; font-size: 9px; line-height: 1.55; }
.reference-toolbar { height: 45px; flex: 0 0 auto; padding: 0 16px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--line); background: #f0ede5; }
.reference-file-name { min-width: 0; display: flex; align-items: center; gap: 7px; color: #625f57; font-size: 10px; }
.reference-file-name span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 520px; }
.reference-toolbar-controls { display: flex; align-items: center; gap: 4px; color: #6f6b63; font-size: 9px; }
.reference-toolbar-controls i { width: 1px; height: 17px; margin: 0 4px; background: #d2cec3; }
.reference-canvas-scroll { min-height: 0; flex: 1; overflow: auto; padding: 24px 34px 44px; background: #dcdad3; }
.reference-page-shell { width: max-content; margin: 0 auto; }
.reference-pdf-stage { position: relative; overflow: visible; cursor: crosshair; background: white; box-shadow: 0 9px 30px rgba(34,33,29,.18); user-select: none; touch-action: none; }
.reference-pdf-stage canvas { position: absolute; inset: 0; display: block; }
.reference-selection { position: absolute; z-index: 5; border: 2px solid var(--accent); background: rgba(198,80,52,.09); box-shadow: 0 0 0 1px rgba(255,255,255,.9), inset 0 0 0 1px rgba(255,255,255,.45); pointer-events: none; }
.reference-selection::before, .reference-selection::after { content: ""; position: absolute; background: rgba(198,80,52,.65); }
.reference-selection::before { left: 50%; top: 0; bottom: 0; width: 1px; }
.reference-selection::after { top: 50%; left: 0; right: 0; height: 1px; }
.reference-selection span { position: absolute; left: -2px; top: -25px; z-index: 2; padding: 4px 7px; color: white; background: var(--accent); border-radius: 5px; font-size: 8px; font-weight: 700; white-space: nowrap; }
.reference-page-loading, .reference-page-error { position: absolute; inset: 0; z-index: 8; display: grid; place-items: center; background: rgba(250,249,245,.94); color: #8f8a80; font-size: 10px; }
.reference-page-error { color: #9d4030; }
.reference-modal-footer { min-height: 74px; flex: 0 0 auto; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-top: 1px solid var(--line); background: #f7f4ed; }
.reference-size-readout { display: flex; align-items: center; gap: 9px; color: var(--accent); }
.reference-size-readout > span { display: flex; flex-direction: column; gap: 2px; }
.reference-size-readout small { color: #8b877d; font-size: 8px; }
.reference-size-readout strong { color: #3f3e38; font: 700 13px Georgia, serif; }
.reference-footer-actions { display: flex; align-items: center; gap: 7px; }
.reference-footer-actions .button { min-height: 34px; padding: 0 11px; font-size: 9px; }
.reference-empty-state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 32px; }
.reference-empty-icon { width: 62px; height: 62px; display: grid; place-items: center; border-radius: 18px; color: var(--accent); background: var(--accent-soft); margin-bottom: 14px; }
.reference-empty-state h3 { margin: 0 0 7px; font-size: 16px; }
.reference-empty-state p { margin: 0 0 20px; color: #817d74; font-size: 10px; }

.toast { position: fixed; z-index: 200; left: 50%; bottom: 25px; transform: translateX(-50%); min-height: 38px; max-width: min(520px, calc(100vw - 40px)); padding: 8px 13px 8px 8px; border-radius: 9px; display: flex; align-items: center; gap: 8px; color: #fff; background: #3d4039; box-shadow: 0 12px 35px rgba(27,26,23,.22); font-size: 10px; animation: toast-in .22s ease-out; }
.toast > span { width: 24px; height: 24px; display: grid; place-items: center; border-radius: 6px; background: rgba(255,255,255,.12); }
.toast.success { background: var(--green); }
.toast.error { background: #9d4030; }
@keyframes toast-in { from { opacity: 0; transform: translate(-50%, 8px); } }

@media (max-width: 1360px) {
  .toolbar-hint { display: none; }
  .canvas-toolbar { grid-template-columns: minmax(0, 1fr) auto; }
  .reference-pdf-button { width: 30px; padding: 0; justify-content: center; font-size: 0; }
}

@media (max-width: 1160px) {
  .workspace { grid-template-columns: 226px minmax(500px, 1fr) 252px; }
  .topbar { grid-template-columns: 240px minmax(0, 1fr) auto; }
  .brand-tagline { display: none; }
  .secure-export-option small { display: none; }
  .toolbar-hint { display: none; }
  .canvas-toolbar { grid-template-columns: minmax(0, 1fr) auto; }
  .reference-pdf-button { width: 30px; padding: 0; justify-content: center; font-size: 0; }
  .canvas-scroll { padding-left: 25px; padding-right: 25px; }
}
